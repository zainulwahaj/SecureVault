# SecureVault environment template.
# Copy this to .env and fill in the secrets. `make start` will auto-generate
# a fresh .env with random values if none exists.

# --- Database / Redis ---
POSTGRES_USER=vault
POSTGRES_PASSWORD=replace-me-with-strong-password
POSTGRES_DB=vaultdb
REDIS_PASSWORD=replace-me-with-strong-password

# --- Backend ---
SECRET_KEY=replace-me-with-64-hex-chars
ENVIRONMENT=development
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:8080"]

# --- Limits (override the policy plan defaults if needed) ---
MAX_FILE_SIZE=104857600
MAX_STORAGE_BYTES=10737418240
MAX_FILE_COUNT=10000
SESSION_EXPIRE_HOURS=24
TRASH_RETENTION_DAYS=30
MAX_FILE_VERSIONS=10

# --- Login rate limiting ---
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT_EMAIL_ATTEMPTS=10
LOGIN_RATE_LIMIT_IP_ATTEMPTS=30

# --- Observability ---
AUDIT_HASH_SECRET=
REQUEST_LOGGING_ENABLED=true
METRICS_ENABLED=false
METRICS_TOKEN=
DEBUG=false

# --- WebAuthn (passkeys) ---
# Override these when running on a real domain — RP_ID must match the host
# the browser sees, ORIGIN must match the scheme+host the browser sends.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SecureVault
WEBAUTHN_ORIGIN=http://localhost:8080

# --- Nginx ---
NGINX_PORT=8080
